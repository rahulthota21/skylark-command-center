# Required: server-side read-only monday.com connection
MONDAY_API_TOKEN=
MONDAY_SALES_BOARD_ID=
MONDAY_WORK_ORDERS_BOARD_ID=

# Optional but recommended: OpenAI-compatible LLM connection.
# Without this, the app still provides deterministic analysis for common business questions,
# and clearly labels that structured AI interpretation is not configured.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
